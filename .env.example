# Local default. Copy to .env before customization. Never commit real secrets.
EMBER_ENVIRONMENT=development
EMBER_ADMIN_NAME=admin
EMBER_ADMIN_PASSWORD=fire-demo-local
EMBER_PUBLIC_ORIGIN=http://localhost:5173
EMBER_DEVICE=cpu
EMBER_SECURE_COOKIE=false
EMBER_DEMO_ENABLED=true
EMBER_STORAGE_BACKEND=local
# Optional: EMBER_DATABASE_URL=postgresql+psycopg://ember:password@localhost:5432/ember
# Production requires a unique 16+ character password, PostgreSQL, HTTPS and secure cookie.
# Password is only used to create the initial account; changing env does NOT reset an existing account.
# Optional server-only public-data keys. Never prefix these with VITE_ or share .env.
KMA_SERVICE_KEY=
NIFOS_SERVICE_KEY=
NAVER_MAPS_CLIENT_ID=
NAVER_MAPS_CLIENT_SECRET=
ITS_API_KEY=
# Optional path overrides:
# EMBER_SPREAD_DATA_PATH=D:/fire-dettection/runtime/spread-data
# EMBER_SPREAD_JOBS_PATH=D:/fire-dettection/runtime/spread-jobs
# Public CCTV ingestion remains disabled until operator verifies provider terms.
EMBER_CCTV_AI_APPROVED=false
EMBER_STREAM_ALLOWED_HOSTS=
EMBER_MONITOR_CAPACITY=4
